22, 3, 1, 23))\0Aassert(t.n == 10 and t[1] == nil and t[10] == nil)\0A\0At = pack(T.testC(\22remove -2; return *\22, 2, 3, 4))\0Atcheck(t, {n=2,2,4})\0A\0At = pack(T.testC(\22insert -1; return *\22, 2, 3))\0Atcheck(t, {n=2,2,3})\0A\0At = pack(T.testC(\22insert 3; return *\22, 2, 3, 4, 5))\0Atcheck(t, {n=4,2,5,3,4})\0A\0At = pack(T.testC(\22replace 2; return *\22, 2, 3, 4, 5))\0Atcheck(t, {n=3,5,3,4})\0A\0At = pack(T.testC(\22replace -2; return *\22, 2, 3, 4, 5))\0Atcheck(t, {n=3,2,3,5})\0A\0At = pack(T.testC(\22remove 3; return *\22, 2, 3, 4, 5))\0Atcheck(t, {n=3,2,4,5})\0A\0At = pack(T.testC(\22copy 3 4; return *\22, 2, 3, 4, 5))\0Atcheck(t, {n=4,2,3,3,5})\0A\0At = pack(T.testC(\22copy -3 -1; return *\22, 2, 3, 4, 5))\0Atcheck(t, {n=4,2,3,4,3})\0A\0Ado   -- testing 'rotate'\0A  local t = {10, 20, 30, 40, 50, 60}\0A  for i = -6, 6 do\0A    local s = string.format(\22rotate 2 %d; return 7\22, i)\0A    local t1 = pack(T.testC(s, 10, 20, 30, 40, 50, 60))\0A    tcheck(t1, t)\0A    table.insert(t, 1, table.remove(t))\0A  end\0A\0A  t = pack(T.testC(\22rotate -2 1; return *\22, 10, 20, 30, 40))\0A  tcheck(t, {10, 20, 40, 30})\0A  t = pack(T.testC(\22rotate -2 -1; return *\22, 10, 20, 30, 40))\0A  tcheck(t, {10, 20, 40, 30})\0A\0A  -- some corner cases\0A  t = pack(T.testC(\22rotate -1 0; return *\22, 10, 20, 30, 40))\0A  tcheck(t, {10, 20, 30, 40})\0A  t = pack(T.testC(\22rotate -1 1; return *\22, 10, 20, 30, 40))\0A  tcheck(t, {10, 20, 30, 40})\0A  t = pack(T.testC(\22rotate 5 -1; return *\22, 10, 20, 30, 40))\0A  tcheck(t, {10, 20, 30, 40})\0Aend\0A\0A\0A-- testing warnings\0AT.testC([[\0A  warningC \22#This shold be a\22\0A  warningC \22 single \22\0A  warning \22warning\22\0A  warningC \22#This should be \22\0A  warning \22another one\22\0A]])\0A\0A\0A-- testing message handlers\0Ado\0A  local f = T.makeCfunc[[\0A    getglobal error\0A    pushstring bola\0A    pcall 1 1 1   # call 'error' with given handler\0A    pushstatus\0A    return 2     # return error message and status\0A  ]]\0A\0A  local msg, st = f(string.upper)   -- function handler\0A  assert(st == \22ERRRUN\22 and msg == \22BOLA\22)\0A  local msg, st = f(string.len)     -- function handler\0A  assert(st == \22ERRRUN\22 and msg == 4)\0A\0Aend\0A\0At = pack(T.testC(\22insert 3; pushvalue 3; remove 3; pushvalue 2; remove 2; \\\0A                  insert 2; pushvalue 1; remove 1; insert 1; \\\0A      insert -2; pushvalue -2; remove -3; return *\22,\0A      2, 3, 4, 5, 10, 40, 90))\0Atcheck(t, {n=7,2,3,4,5,10,40,90})\0A\0At = pack(T.testC(\22concat 5; return *\22, \22alo\22, 2, 3, \22joao\22, 12))\0Atcheck(t, {n=1,\22alo23joao12\22})\0A\0A-- testing MULTRET\0At = pack(T.testC(\22call 2,-1; return *\22,\0A     function (a,b) return 1,2,3,4,a,b end, \22alo\22, \22joao\22))\0Atcheck(t, {n=6,1,2,3,4,\22alo\22, \22joao\22})\0A\0Ado  -- test returning more results than fit in the caller stack\0A  local a = {}\0A  for i=1,1000 do a[i] = true end; a[999] = 10\0A  local b = T.testC([[pcall 1 -1 0; pop 1; tostring -1; return 1]],\0A                    table.unpack, a)\0A  assert(b == \2210\22)\0Aend\0A\0A\0A-- testing globals\0A_G.AA = 14; _G.BB = \22a31\22\0Alocal a = {T.testC[[\0A  getglobal AA;\0A  getglobal BB;\0A  getglobal BB;\0A  setglobal AA;\0A  return *\0A]]}\0Aassert(a[2] == 14 and a[3] == \22a31\22 and a[4] == nil and _G.AA == \22a31\22)\0A\0A_G.AA, _G.BB = nil\0A\0A-- testing arith\0Aassert(T.testC(\22pushnum 10; pushnum 20; arith /; return 1\22) == 0.5)\0Aassert(T.testC(\22pushnum 10; pushnum 20; arith -; return 1\22) == -10)\0Aassert(T.testC(\22pushnum 10; pushnum -20; arith *; return 1\22) == -200)\0Aassert(T.testC(\22pushnum 10; pushnum 3; arith ^; return 1\22) == 1000)\0Aassert(T.testC(\22pushnum 10; pushstring 20; arith /; return 1\22) == 0.5)\0Aassert(T.testC(\22pushstring 10; pushnum 20; arith -; return 1\22) == -10)\0Aassert(T.testC(\22pushstring 10; pushstring -20; arith *; return 1\22) == -200)\0Aassert(T.testC(\22pushstring 10; pushstring 3; arith ^; return 1\22) == 1000)\0Aassert(T.testC(\22arith /; return 1\22, 2, 0) == 10.0/0)\0Aa = T.testC(\22pushnum 10; pushint 3; arith \\\\; return 1\22)\0Aassert(a == 3.0 and math.type(a) == \22float\22)\0Aa = T.testC(\22pushint 10; pushint 3; arith \\\\; return 1\22)\0Aassert(a == 3 and math.type(a) == \22integer\22)\0Aa = assert(T.testC(\22pushint 10; pushint 3; arith +; return 1\22))\0Aassert(a == 13 and math.type(a) == \22integer\22)\0Aa = assert(T.testC(\22pushnum 10; pushint 3; arith +; return 1\22))\0Aassert(a == 13 and math.type(a) == \22float\22)\0Aa,b,c = T.testC([[pushnum 1;\0A                  pushstring 10; arith _;\0A                  pushstring 5; return 3]])\0Aassert(a == 1 and b == -10 and c == \225\22)\0Alocal mt = {\0A      __add = function (a,b) return setmetatable({a[1] + b[1]}, mt) end,\0A      __mod = function (a,b) return setmetatable({a[1] % b[1]}, mt) end,\0A      __unm = function (a) return setmetatable({a[1]* 2}, mt) end}\0Aa,b,c = setmetatable({4}, mt),\0A        setmetatable({8}, mt),\0A        setmetatable({-3}, mt)\0Alocal x,y,z = T.testC(\22arith +; return 2\22, 10, a, b)\0Aassert(x == 10 and y[1] == 12 and z == nil)\0Aassert(T.testC(\22arith %; return 1\22, a, c)[1] == 4%-3)\0Aassert(T.testC(\22arith _; arith +; arith %; return 1\22, b, a, c)[1] ==\0A               8 % (4 + (-3)*2))\0A\0A-- errors in arithmetic\0Acheckerr(\22divide by zero\22, T.testC, \22arith \\\\\22, 10, 0)\0Acheckerr(\22%%0\22, T.testC, \22arith %\22, 10, 0)\0A\0A\0A-- testing lessthan and lessequal\0Aassert(T.testC(\22compare LT 2 5, return 1\22, 3, 2, 2, 4, 2, 2))\0Aassert(T.testC(\22compare LE 2 5, return 1\22, 3, 2, 2, 4, 2, 2))\0Aassert(not T.testC(\22compare LT 3 4, return 1\22, 3, 2, 2, 4, 2, 2))\0Aassert(T.testC(\22compare LE 3 4, return 1\22, 3, 2, 2, 4, 2, 2))\0Aassert(T.testC(\22compare LT 5 2, return 1\22, 4, 2, 2, 3, 2, 2))\0Aassert(not T.testC(\22compare LT 2 -3, return 1\22, \224\22, \222\22, \222\22, \223\22, \222\22, \222\22))\0Aassert(not T.testC(\22compare LT -3 2, return 1\22, \223\22, \222\22, \222\22, \224\22, \222\22, \222\22))\0A\0A-- non-valid indices produce false\0Aassert(not T.testC(\22compare LT 1 4, return 1\22))\0Aassert(not T.testC(\22compare LE 9 1, return 1\22))\0Aassert(not T.testC(\22compare EQ 9 9, return 1\22))\0A\0Alocal b = {__lt = function (a,b) return a[1] < b[1] end}\0Alocal a1,a3,a4 = setmetatable({1}, b),\0A                 setmetatable({3}, b),\0A                 setmetatable({4}, b)\0Aassert(T.testC(\22compare LT 2 5, return 1\22, a3, 2, 2, a4, 2, 2))\0Aassert(T.testC(\22compare LE 2 5, return 1\22, a3, 2, 2, a4, 2, 2))\0Aassert(T.testC(\22compare LT 5 -6, return 1\22, a4, 2, 2, a3, 2, 2))\0Aa,b = T.testC(\22compare LT 5 -6, return 2\22, a1, 2, 2, a3, 2, 20)\0Aassert(a == 20 and b == false)\0Aa,b = T.testC(\22compare LE 5 -6, return 2\22, a1, 2, 2, a3, 2, 20)\0Aassert(a == 20 and b == false)\0Aa,b = T.testC(\22compare LE 5 -6, return 2\22, a1, 2, 2, a1, 2, 20)\0Aassert(a == 20 and b == true)\0A\0A\0Ado  -- testing lessthan and lessequal with metamethods\0A  local mt = {__lt = function (a,b) return a[1] < b[1] end,\0A              __le = function (a,b) return a[1] <= b[1] end,\0A              __eq = function (a,b) return a[1] == b[1] end}\0A  local function O (x)\0A    return setmetatable({x}, mt)\0A  end\0A\0A  local a, b = T.testC(\22compare LT 2 3; pushint 10; return 2\22, O(1), O(2))\0A  assert(a == true and b == 10)\0A  local a, b = T.testC(\22compare LE 2 3; pushint 10; return 2\22, O(3), O(2))\0A  assert(a == false and b == 10)\0A  local a, b = T.testC(\22compare EQ 2 3; pushint 10; return 2\22, O(3), O(3))\0A  assert(a == true and b == 10)\0Aend\0A\0A-- testing length\0Alocal t = setmetatable({x = 20}, {__len = function (t) return t.x end})\0Aa,b,c = T.testC([[\0A   len 2;\0A   Llen 2;\0A   objsize 2;\0A   return 3\0A]], t)\0Aassert(a == 20 and b == 20 and c == 0)\0A\0At.x = \22234\22; t[1] = 20\0Aa,b,c = T.testC([[\0A   len 2;\0A   Llen 2;\0A   objsize 2;\0A   return 3\0A]], t)\0Aassert(a == \22234\22 and b == 234 and c == 1)\0A\0At.x = print; t[1] = 20\0Aa,c = T.testC([[\0A   len 2;\0A   objsize 2;\0A   return 2\0A]], t)\0Aassert(a == print and c == 1)\0A\0A\0A-- testing __concat\0A\0Aa = setmetatable({x=\22u\22}, {__concat = function (a,b) return a.x..'.'..b.x end})\0Ax,y = T.testC([[\0A  pushnum 5\0A  pushvalue 2;\0A  pushvalue 2;\0A  concat 2;\0A  pushvalue -2;\0A  return 2;\0A]], a, a)\0Aassert(x == a..a and y == 5)\0A\0A-- concat with 0 elements\0Aassert(T.testC(\22concat 0; return 1\22) == \22\22)\0A\0A-- concat with 1 element\0Aassert(T.testC(\22concat 1; return 1\22, \22xuxu\22) == \22xuxu\22)\0A\0A\0A\0A-- testing lua_is\0A\0Alocal function B (x) return x and 1 or 0 end\0A\0Alocal function count (x, n)\0A  n = n or 2\0A  local prog = [[\0A    isnumber %d;\0A    isstring %d;\0A    isfunction %d;\0A    iscfunction %d;\0A    istable %d;\0A    isuserdata %d;\0A    isnil %d;\0A    isnull %d;\0A    return 8\0A  ]]\0A  prog = string.format(prog, n, n, n, n, n, n, n, n)\0A  local a,b,c,d,e,f,g,h = T.testC(prog, x)\0A  return B(a)+B(b)+B(c)+B(d)+B(e)+B(f)+B(g)+(100*B(h))\0Aend\0A\0Aassert(count(3) == 2)\0Aassert(count('alo') == 1)\0Aassert(count('32') == 2)\0Aassert(count({}) == 1)\0Aassert(count(print) == 2)\0Aassert(count(function () end) == 1)\0Aassert(count(nil) == 1)\0Aassert(count(io.stdin) == 1)\0Aassert(count(nil, 15) == 100)\0A\0A\0A-- testing lua_to...\0A\0Alocal function to (s, x, n)\0A  n = n or 2\0A  return T.testC(string.format(\22%s %d; return 1\22, s, n), x)\0Aend\0A\0Alocal null = T.pushuserdata(0)\0Alocal hfunc = string.gmatch(\22\22, \22\22)    -- a \22heavy C function\22 (with upvalues)\0Aassert(debug.getupvalue(hfunc, 1))\0Aassert(to(\22tostring\22, {}) == nil)\0Aassert(to(\22tostring\22, \22alo\22) == \22alo\22)\0Aassert(to(\22tostring\22, 12) == \2212\22)\0Aassert(to(\22tostring\22, 12, 3) == nil)\0Aassert(to(\22objsize\22, {}) == 0)\0Aassert(to(\22objsize\22, {1,2,3}) == 3)\0Aassert(to(\22objsize\22, \22alo\\0\\0a\22) == 6)\0Aassert(to(\22objsize\22, T.newuserdata(0)) == 0)\0Aassert(to(\22objsize\22, T.newuserdata(101)) == 101)\0Aassert(to(\22objsize\22, 124) == 0)\0Aassert(to(\22objsize\22, true) == 0)\0Aassert(to(\22tonumber\22, {}) == 0)\0Aassert(to(\22tonumber\22, \2212\22) == 12)\0Aassert(to(\22tonumber\22, \22s2\22) == 0)\0Aassert(to(\22tonumber\22, 1, 20) == 0)\0Aassert(to(\22topointer\22, 10) == null)\0Aassert(to(\22topointer\22, true) == null)\0Aassert(to(\22topointer\22, nil) == null)\0Aassert(to(\22topointer\22, \22abc\22) ~= null)\0Aassert(to(\22topointer\22, string.rep(\22x\22, 10)) ==\0A       to(\22topointer\22, string.rep(\22x\22, 10)))    -- short strings\0Ado    -- long strings\0A  local s1 = string.rep(\22x\22, 300)\0A  local s2 = string.rep(\22x\22, 300)\0A  assert(to(\22topointer\22, s1) ~= to(\22topointer\22, s2))\0Aend\0Aassert(to(\22topointer\22, T.pushuserdata(20)) ~= null)\0Aassert(to(\22topointer\22, io.read) ~= null)           -- light C function\0Aassert(to(\22topointer\22, hfunc) ~= null)        -- \22heavy\22 C function\0Aassert(to(\22topointer\22, function () end) ~= null)   -- Lua function\0Aassert(to(\22topointer\22, io.stdin) ~= null)   -- full userdata\0Aassert(to(\22func2num\22, 20) == 0)\0Aassert(to(\22func2num\22, T.pushuserdata(10)) == 0)\0Aassert(to(\22func2num\22, io.read) ~= 0)     -- light C function\0Aassert(to(\22func2num\22, hfunc) ~= 0)  -- \22heavy\22 C function (with upvalue)\0Aa = to(\22tocfunction\22, math.deg)\0Aassert(a(3) == math.deg(3) and a == math.deg)\0A\0A\0Aprint(\22testing panic function\22)\0Ado\0A  -- trivial error\0A  assert(T.checkpanic(\22pushstring hi; error\22) == \22hi\22)\0A\0A  -- using the stack inside panic\0A  assert(T.checkpanic(\22pushstring hi; error;\22,\0A    [[checkstack 5 XX\0A      pushstring ' alo'\0A      pushstring ' mundo'\0A      concat 3]]) == \22hi alo mundo\22)\0A\0A  -- \22argerror\22 without frames\0A  assert(T.checkpanic(\22loadstring 4\22) ==\0A      \22bad argument #4 (string expected, got no value)\22)\0A\0A\0A  -- memory error\0A  T.totalmem(T.totalmem()+10000)   -- set low memory limit (+10k)\0A  assert(T.checkpanic(\22newuserdata 20000\22) == MEMERRMSG)\0A  T.totalmem(0)          -- restore high limit\0A\0A  -- stack error\0A  if not _soft then\0A    local msg = T.checkpanic[[\0A      pushstring \22function f() f() end\22\0A      loadstring -1; call 0 0\0A      getglobal f; call 0 0\0A    ]]\0A    assert(string.find(msg, \22stack overflow\22))\0A  end\0A\0A  -- exit in panic still close to-be-closed variables\0A  assert(T.checkpanic([[\0A    pushstring \22return {__close = function () Y = 'ho'; end}\22\0A    newtable\0A    loadstring -2\0A    call 0 1\0A    setmetatable -2\0A    toclose -1\0A    pushstring \22hi\22\0A    error\0A  ]],\0A  [[\0A    getglobal Y\0A    concat 2         # concat original error with global Y\0A  ]]) == \22hiho\22)\0A\0A\0Aend\0A\0A-- testing deep C stack\0Aif not _soft then\0A  print(\22testing stack overflow\22)\0A  collectgarbage(\22stop\22)\0A  checkerr(\22XXXX\22, T.testC, \22checkstack 1000023 XXXX\22)   -- too deep\0A  -- too deep (with no message)\0A  checkerr(\22^stack overflow$\22, T.testC, \22checkstack 1000023 ''\22)\0A  local s = string.rep(\22pushnil;checkstack 1 XX;\22, 1000000)\0A  checkerr(\22overflow\22, T.testC, s)\0A  collectgarbage(\22restart\22)\0A  print'+'\0Aend\0A\0Alocal lim = _soft and 500 or 12000\0Alocal prog = {\22checkstack \22 .. (lim * 2 + 100) .. \22msg\22, \22newtable\22}\0Afor i = 1,lim do\0A  prog[#prog + 1] = \22pushnum \22 .. i\0A  prog[#prog + 1] = \22pushnum \22 .. i * 10\0Aend\0A\0Aprog[#prog + 1] = \22rawgeti R 2\22   -- get global table in registry\0Aprog[#prog + 1] = \22insert \22 .. -(2*lim + 2)\0A\0Afor i = 1,lim do\0A  prog[#prog + 1] = \22settable \22 .. -(2*(lim - i + 1) + 1)\0Aend\0A\0Aprog[#prog + 1] = \22return 2\22\0A\0Aprog = table.concat(prog, \22;\22)\0Alocal g, t = T.testC(prog)\0Aassert(g == _G)\0Afor i = 1,lim do assert(t[i] == i*10); t[i] = undef end\0Aassert(next(t) == nil)\0Aprog, g, t = nil\0A\0A-- testing errors\0A\0Aa = T.testC([[\0A  loadstring 2; pcall 0 1 0;\0A  pushvalue 3; insert -2; pcall 1 1 0;\0A  pcall 0 0 0;\0A  return 1\0A]], \22XX=150\22, function (a) assert(a==nil); return 3 end)\0A\0Aassert(type(a) == 'string' and XX == 150)\0A_G.XX = nil\0A\0Alocal function check3(p, ...)\0A  local arg = {...}\0A  assert(#arg == 3)\0A  assert(string.find(arg[3], p))\0Aend\0Acheck3(\22:1:\22, T.testC(\22loadstring 2; return *\22, \22x=\22))\0Acheck3(\22%.\22, T.testC(\22loadfile 2; return *\22, \22.\22))\0Acheck3(\22xxxx\22, T.testC(\22loadfile 2; return *\22, \22xxxx\22))\0A\0A-- test errors in non protected threads\0Alocal function checkerrnopro (code, msg)\0A  local th = coroutine.create(function () end)  -- create new thread\0A  local stt, err = pcall(T.testC, th, code)   -- run code there\0A  assert(not stt and string.find(err, msg))\0Aend\0A\0Aif not _soft then\0A  collectgarbage(\22stop\22)   -- avoid __gc with full stack\0A  checkerrnopro(\22pushnum 3; call 0 0\22, \22attempt to call\22)\0A  print\22testing stack overflow in unprotected thread\22\0A  function F () F() end\0A  checkerrnopro(\22getglobal 'F'; call 0 0;\22, \22stack overflow\22)\0A  F = nil\0A  collectgarbage(\22restart\22)\0Aend\0Aprint\22+\22\0A\0A\0A-- testing table access\0A\0Ado   -- getp/setp\0A  local a = {}\0A  local a1 = T.testC(\22rawsetp 2 1; return 1\22, a, 20)\0A  assert(a == a1)\0A  assert(a[T.pushuserdata(1)] == 20)\0A  local a1, res = T.testC(\22rawgetp -1 1; return 2\22, a)\0A  assert(a == a1 and res == 20)\0Aend\0A\0A\0Ado  -- using the table itself as index\0A  local a = {}\0A  a[a] = 10\0A  local prog = \22gettable -1; return *\22\0A  local res = {T.testC(prog, a)}\0A  assert(#res == 2 and res[1] == prog and res[2] == 10)\0A\0A  local prog = \22settable -2; return *\22\0A  local res = {T.testC(prog, a, 20)}\0A  assert(a[a] == 20)\0A  assert(#res == 1 and res[1] == prog)\0A\0A  -- raw\0A  a[a] = 10\0A  local prog = \22rawget -1; return *\22\0A  local res = {T.testC(prog, a)}\0A  assert(#res == 2 and res[1] == prog and res[2] == 10)\0A\0A  local prog = \22rawset -2; return *\22\0A  local res = {T.testC(prog, a, 20)}\0A  assert(a[a] == 20)\0A  assert(#res == 1 and res[1] == prog)\0A\0A  -- using the table as the value to set\0A  local prog = \22rawset -1; return *\22\0A  local res = {T.testC(prog, 30, a)}\0A  assert(a[30] == a)\0A  assert(#res == 1 and res[1] == prog)\0A\0A  local prog = \22settable -1; return *\22\0A  local res = {T.testC(prog, 40, a)}\0A  assert(a[40] == a)\0A  assert(#res == 1 and res[1] == prog)\0A\0A  local prog = \22rawseti -1 100; return *\22\0A  local res = {T.testC(prog, a)}\0A  assert(a[100] == a)\0A  assert(#res == 1 and res[1] == prog)\0A\0A  local prog = \22seti -1 200; return *\22\0A  local res = {T.testC(prog, a)}\0A  assert(a[200] == a)\0A  assert(#res == 1 and res[1] == prog)\0Aend\0A\0Aa = {x=0, y=12}\0Ax, y = T.testC(\22gettable 2; pushvalue 4; gettable 2; return 2\22,\0A                a, 3, \22y\22, 4, \22x\22)\0Aassert(x == 0 and y == 12)\0AT.testC(\22settable -5\22, a, 3, 4, \22x\22, 15)\0Aassert(a.x == 15)\0Aa[a] = print\0Ax = T.testC(\22gettable 2; return 1\22, a)  -- table and key are the same object!\0Aassert(x == print)\0AT.testC(\22settable 2\22, a, \22x\22)    -- table and key are the same object!\0Aassert(a[a] == \22x\22)\0A\0Ab = setmetatable({p = a}, {})\0Agetmetatable(b).__index = function (t, i) return t.p[i] end\0Alocal k, x = T.testC(\22gettable 3, return 2\22, 4, b, 20, 35, \22x\22)\0Aassert(x == 15 and k == 35)\0Ak = T.testC(\22getfield 2 y, return 1\22, b)\0Aassert(k == 12)\0Agetmetatable(b).__index = function (t, i) return a[i] end\0Agetmetatable(b).__newindex = function (t, i,v ) a[i] = v end\0Ay = T.testC(\22insert 2; gettable -5; return 1\22, 2, 3, 4, \22y\22, b)\0Aassert(y == 12)\0Ak = T.testC(\22settable -5, return 1\22, b, 3, 4, \22x\22, 16)\0Aassert(a.x == 16 and k == 4)\0Aa[b] = 'xuxu'\0Ay = T.testC(\22gettable 2, return 1\22, b)\0Aassert(y == 'xuxu')\0AT.testC(\22settable 2\22, b, 19)\0Aassert(a[b] == 19)\0A\0A--\0Ado   -- testing getfield/setfield with long keys\0A  local t = {_012345678901234567890123456789012345678901234567890123456789 = 32}\0A  local a = T.testC([[\0A    getfield 2 _012345678901234567890123456789012345678901234567890123456789\0A    return 1\0A  ]], t)\0A  assert(a == 32)\0A  local a = T.testC([[\0A    pushnum 33\0A    setglobal _012345678901234567890123456789012345678901234567890123456789\0A  ]])\0A  assert(_012345678901234567890123456789012345678901234567890123456789 == 33)\0A  _012345678901234567890123456789012345678901234567890123456789 = nil\0Aend\0A\0A-- testing next\0Aa = {}\0At = pack(T.testC(\22next; return *\22, a, nil))\0Atcheck(t, {n=1,a})\0Aa = {a=3}\0At = pack(T.testC(\22next; return *\22, a, nil))\0Atcheck(t, {n=3,a,'a',3})\0At = pack(T.testC(\22next; pop 1; next; return *\22, a, nil))\0Atcheck(t, {n=1,a})\0A\0A\0A\0A-- testing upvalues\0A\0Ado\0A  local A = T.testC[[ pushnum 10; pushnum 20; pushcclosure 2; return 1]]\0A  t, b, c = A([[pushvalue U0; pushvalue U1; pushvalue U2; return 3]])\0A  assert(b == 10 and c == 20 and type(t) == 'table')\0A  a, b = A([[tostring U3; tonumber U4; return 2]])\0A  assert(a == nil and b == 0)\0A  A([[pushnum 100; pushnum 200; replace U2; replace U1]])\0A  b, c = A([[pushvalue U1; pushvalue U2; return 2]])\0A  assert(b == 100 and c == 200)\0A  A([[replace U2; replace U1]], {x=1}, {x=2})\0A  b, c = A([[pushvalue U1; pushvalue U2; return 2]])\0A  assert(b.x == 1 and c.x == 2)\0A  T.checkmemory()\0Aend\0A\0A\0A-- testing absent upvalues from C-function pointers\0Aassert(T.testC[[isnull U1; return 1]] == true)\0Aassert(T.testC[[isnull U100; return 1]] == true)\0Aassert(T.testC[[pushvalue U1; return 1]] == nil)\0A\0Alocal f = T.testC[[ pushnum 10; pushnum 20; pushcclosure 2; return 1]]\0Aassert(T.upvalue(f, 1) == 10 and\0A       T.upvalue(f, 2) == 20 and\0A       T.upvalue(f, 3) == nil)\0AT.upvalue(f, 2, \22xuxu\22)\0Aassert(T.upvalue(f, 2) == \22xuxu\22)\0A\0A\0A-- large closures\0Ado\0A  local A = \22checkstack 300 msg;\22 ..\0A            string.rep(\22pushnum 10;\22, 255) ..\0A            \22pushcclosure 255; return 1\22\0A  A = T.testC(A)\0A  for i=1,255 do\0A    assert(A((\22pushvalue U%d; return 1\22):format(i)) == 10)\0A  end\0A  assert(A(\22isnull U256; return 1\22))\0A  assert(not A(\22isnil U256; return 1\22))\0Aend\0A\0A\0A\0A-- testing get/setuservalue\0A-- bug in 5.1.2\0Acheckerr(\22got number\22, debug.setuservalue, 3, {})\0Acheckerr(\22got nil\22, debug.setuservalue, nil, {})\0Acheckerr(\22got light userdata\22, debug.setuservalue, T.pushuserdata(1), {})\0A\0A-- testing multiple user values\0Alocal b = T.newuserdata(0, 10)\0Afor i = 1, 10 do\0A  local v, p = debug.getuservalue(b, i)\0A  assert(v == nil and p)\0Aend\0Ado   -- indices out of range\0A  local v, p = debug.getuservalue(b, -2)\0A  assert(v == nil and not p)\0A  local v, p = debug.getuservalue(b, 11)\0A  assert(v == nil and not p)\0Aend\0Alocal t = {true, false, 4.56, print, {}, b, \22XYZ\22}\0Afor k, v in ipairs(t) do\0A  debug.setuservalue(b, v, k)\0Aend\0Afor k, v in ipairs(t) do\0A  local v1, p = debug.getuservalue(b, k)\0A  assert(v1 == v and p)\0Aend\0A\0Aassert(not debug.getuservalue(4))\0A\0Adebug.setuservalue(b, function () return 10 end, 10)\0Acollectgarbage()   -- function should not be collected\0Aassert(debug.getuservalue(b, 10)() == 10)\0A\0Adebug.setuservalue(b, 134)\0Acollectgarbage()   -- number should not be a problem for collector\0Aassert(debug.getuservalue(b) == 134)\0A\0A\0A-- test barrier for uservalues\0Ado\0A  local oldmode = collectgarbage(\22incremental\22)\0A  T.gcstate(\22atomic\22)\0A  assert(T.gccolor(b) == \22black\22)\0A  debug.setuservalue(b, {x = 100})\0A  T.gcstate(\22pause\22)  -- complete collection\0A  assert(debug.getuservalue(b).x == 100)  -- uvalue should be there\0A  collectgarbage(oldmode)\0Aend\0A\0A-- long chain of userdata\0Afor i = 1, 1000 do\0A  local bb = T.newuserdata(0, 1)\0A  debug.setuservalue(bb, b)\0A  b = bb\0Aend\0Acollectgarbage()     -- nothing should not be collected\0Afor i = 1, 1000 do\0A  b = debug.getuservalue(b)\0Aend\0Aassert(debug.getuservalue(b).x == 100)\0Ab = nil\0A\0A\0A-- testing locks (refs)\0A\0A-- reuse of references\0Alocal i = T.ref{}\0AT.unref(i)\0Aassert(T.ref{} == i)\0A\0Alocal Arr = {}\0Alocal Lim = 100\0Afor i=1,Lim do   -- lock many objects\0A  Arr[i] = T.ref({})\0Aend\0A\0Aassert(T.ref(nil) == -1 and T.getref(-1) == nil)\0AT.unref(-1); T.unref(-1)\0A\0Afor i=1,Lim do   -- unlock all them\0A  T.unref(Arr[i])\0Aend\0A\0Alocal function printlocks ()\0A  local f = T.makeCfunc(\22gettable R; return 1\22)\0A  local n = f(\22n\22)\0A  print(\22n\22, n)\0A  for i=0,n do\0A    print(i, f(i))\0A  end\0Aend\0A\0A\0Afor i=1,Lim do   -- lock many objects\0A  Arr[i] = T.ref({})\0Aend\0A\0Afor i=1,Lim,2 do   -- unlock half of them\0A  T.unref(Arr[i])\0Aend\0A\0Aassert(type(T.getref(Arr[2])) == 'table')\0A\0A\0Aassert(T.getref(-1) == nil)\0A\0A\0Aa = T.ref({})\0A\0Acollectgarbage()\0A\0Aassert(type(T.getref(a)) == 'table')\0A\0A\0A-- colect in cl the `val' of all collected userdata\0Alocal tt = {}\0Alocal cl = {n=0}\0AA = nil; B = nil\0Alocal F\0AF = function (x)\0A  local udval = T.udataval(x)\0A  table.insert(cl, udval)\0A  local d = T.newuserdata(100)   -- create garbage\0A  d = nil\0A  assert(debug.getmetatable(x).__gc == F)\0A  assert(load(\22table.insert({}, {})\22))()   -- create more garbage\0A  assert(not collectgarbage())    -- GC during GC (no op)\0A  local dummy = {}    -- create more garbage during GC\0A  if A ~= nil then\0A    assert(type(A) == \22userdata\22)\0A    assert(T.udataval(A) == B)\0A    debug.getmetatable(A)    -- just access it\0A  end\0A  A = x   -- ressurect userdata\0A  B = udval\0A  return 1,2,3\0Aend\0Att.__gc = F\0A\0A\0A-- test whether udate collection frees memory in the right time\0Ado\0A  collectgarbage();\0A  collectgarbage();\0A  local x = collectgarbage(\22count\22);\0A  local a = T.newuserdata(5001)\0A  assert(T.testC(\22objsize 2; return 1\22, a) == 5001)\0A  assert(collectgarbage(\22count\22) >= x+4)\0A  a = nil\0A  collectgarbage();\0A  assert(collectgarbage(\22count\22) <= x+1)\0A  -- udata without finalizer\0A  x = collectgarbage(\22count\22)\0A  collectgarbage(\22stop\22)\0A  for i=1,1000 do T.newuserdata(0) end\0A  assert(collectgarbage(\22count\22) > x+10)\0A  collectgarbage()\0A  assert(collectgarbage(\22count\22) <= x+1)\0A  -- udata with finalizer\0A  collectgarbage()\0A  x = collectgarbage(\22count\22)\0A  collectgarbage(\22stop\22)\0A  a = {__gc = function () end}\0A  for i=1,1000 do debug.setmetatable(T.newuserdata(0), a) end\0A  assert(collectgarbage(\22count\22) >= x+10)\0A  collectgarbage()  -- this collection only calls TM, without freeing memory\0A  assert(collectgarbage(\22count\22) >= x+10)\0A  collectgarbage()  -- now frees memory\0A  assert(collectgarbage(\22count\22) <= x+1)\0A  collectgarbage(\22restart\22)\0Aend\0A\0A\0Acollectgarbage(\22stop\22)\0A\0A-- create 3 userdatas with tag `tt'\0Aa = T.newuserdata(0); debug.setmetatable(a, tt); local na = T.udataval(a)\0Ab = T.newuserdata(0); debug.setmetatable(b, tt); local nb = T.udataval(b)\0Ac = T.newuserdata(0); debug.setmetatable(c, tt); local nc = T.udataval(c)\0A\0A-- create userdata without meta table\0Ax = T.newuserdata(4)\0Ay = T.newuserdata(0)\0A\0Acheckerr(\22FILE%* expected, got userdata\22, io.input, a)\0Acheckerr(\22FILE%* expected, got userdata\22, io.input, x)\0A\0Aassert(debug.getmetatable(x) == nil and debug.getmetatable(y) == nil)\0A\0Alocal d = T.ref(a);\0Alocal e = T.ref(b);\0Alocal f = T.ref(c);\0At = {T.getref(d), T.getref(e), T.getref(f)}\0Aassert(t[1] == a and t[2] == b and t[3] == c)\0A\0At=nil; a=nil; c=nil;\0AT.unref(e); T.unref(f)\0A\0Acollectgarbage()\0A\0A-- check that unref objects have been collected\0Aassert(#cl == 1 and cl[1] == nc)\0A\0Ax = T.getref(d)\0Aassert(type(x) == 'userdata' and debug.getmetatable(x) == tt)\0Ax =nil\0Att.b = b  -- create cycle\0Att=nil    -- frees tt for GC\0AA = nil\0Ab = nil\0AT.unref(d);\0Alocal n5 = T.newuserdata(0)\0Adebug.setmetatable(n5, {__gc=F})\0An5 = T.udataval(n5)\0Acollectgarbage()\0Aassert(#cl == 4)\0A-- check order of collection\0Aassert(cl[2] == n5 and cl[3] == nb and cl[4] == na)\0A\0Acollectgarbage\22restart\22\0A\0A\0Aa, na = {}, {}\0Afor i=30,1,-1 do\0A  a[i] = T.newuserdata(0)\0A  debug.setmetatable(a[i], {__gc=F})\0A  na[i] = T.udataval(a[i])\0Aend\0Acl = {}\0Aa = nil; collectgarbage()\0Aassert(#cl == 30)\0Afor i=1,30 do assert(cl[i] == na[i]) end\0Ana = nil\0A\0A\0Afor i=2,Lim,2 do   -- unlock the other half\0A  T.unref(Arr[i])\0Aend\0A\0Ax = T.newuserdata(41); debug.setmetatable(x, {__gc=F})\0Aassert(T.testC(\22objsize 2; return 1\22, x) == 41)\0Acl = {}\0Aa = {[x] = 1}\0Ax = T.udataval(x)\0Acollectgarbage()\0A-- old `x' cannot be collected (`a' still uses it)\0Aassert(#cl == 0)\0Afor n in pairs(a) do a[n] = undef end\0Acollectgarbage()\0Aassert(#cl == 1 and cl[1] == x)   -- old `x' must be collected\0A\0A-- testing lua_equal\0Aassert(T.testC(\22compare EQ 2 4; return 1\22, print, 1, print, 20))\0Aassert(T.testC(\22compare EQ 3 2; return 1\22, 'alo', \22alo\22))\0Aassert(T.testC(\22compare EQ 2 3; return 1\22, nil, nil))\0Aassert(not T.testC(\22compare EQ 2 3; return 1\22, {}, {}))\0Aassert(not T.testC(\22compare EQ 2 3; return 1\22))\0Aassert(not T.testC(\22compare EQ 2 3; return 1\22, 3))\0A\0A-- testing lua_equal with fallbacks\0Ado\0A  local map = {}\0A  local t = {__eq = function (a,b) return map[a] == map[b] end}\0A  local function f(x)\0A    local u = T.newuserdata(0)\0A    debug.setmetatable(u, t)\0A    map[u] = x\0A    return u\0A  end\0A  assert(f(10) == f(10))\0A  assert(f(10) ~= f(11))\0A  assert(T.testC(\22compare EQ 2 3; return 1\22, f(10), f(10)))\0A  assert(not T.testC(\22compare EQ 2 3; return 1\22, f(10), f(20)))\0A  t.__eq = nil\0A  assert(f(10) ~= f(10))\0Aend\0A\0Aprint'+'\0A\0A\0A\0A-- testing changing ho
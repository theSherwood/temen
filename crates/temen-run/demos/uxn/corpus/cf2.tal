( return-mode and keep-mode jumps, JSR2r/JMP2r, nested subroutines, LIT2r, STH2kr )
|0100
  LIT2r 0102 ADD2r STH2r          ( 0003 )
  #0005 ;f JSR2 ADD2              ( 0503 )
  ;g JSR2                         ( 07 )
  #0a SFT2 #01 SFT2
  #00 &l INC DUP #03 LTH ,&l JCN
  DUP2 STH2 STH2r
  LIT2 abcd ;h JSR2
  #0007 LITr 01 STH2kr ADD2r POP2r
BRK
@f #0100 MUL2 JMP2r
@g LITr 07 STHr ,&back JMPk POP JMP2r &back INC JMP2r
@h SWP #01 SUB SWP #01 ADD JMP2r

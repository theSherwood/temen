; forth.temt — a sectorforth-class Forth whose kernel is hand-written Temen text IR and whose
; every colon definition is compiled to a verified Temen IR unit through the §22 `Jit`
; capability (issue #1214). No C, no chibicc runtime: this module *is* the whole kernel.
;
;   temen-run crates/temen-run/demos/forth/forth.temt --stdin program.fs
;
; Design (issue #1214): the data stack is SSA, not memory. A word is an IR function whose
; signature *is* its declared stack effect — `: sq ( n -- n ) dup * ;` becomes `(i64) -> (i64)`
; — and the compiler keeps a compile-time virtual stack of SSA value indices, so `dup swap over
; drop rot nip tuck` emit nothing. `if/else/then` and `begin/until|again|while/repeat` are IR
; blocks whose params carry the live virtual stack. A word calls another by `call.dyn` on its
; `Jit.install` slot; `recurse` is `call 0`. Each top-level line is an anonymous unit that is
; compiled, `invoke`d, and `release`d (the `jit_repl.c` shape); a persistent REPL stack in
; memory is touched only by those anonymous units (underflow loads from it, leftovers store to
; it). Fibers are Forth words over `cont.new` / `cont.resume` / `suspend`; threads and the futex
; are kernel functions (`spawn`/`join`/`wait`/`notify`) reached by `call.dyn`, atomics are templates.
;
; The kernel's own primitives are a flat table declared in the prelude (below) with the one
; hardwired defining word `prim <name> <kind> <nin> <nout> <payload>`:
;   kind 0 = installed word / kernel function (payload = call.dyn slot)
;   kind 1 = i64 binop template (payload = opcode byte)   kind 3 = i64 compare (→ 0/1)
;   kind 4 = load (payload = load opcode)                  kind 5 = store (payload = store opcode)
;   kind 6 = constant (payload = value; `variable`/`create`) kind 8 = i64.eqz (`0=`)
;   kind 7 = i64 atomic rmw `( n addr -- old )` (payload = rmw op)  kind 9 = cmpxchg `( exp new addr -- old )`
;   kind 10 = atomic load `( addr -- x )`                 kind 11 = atomic store `( x addr -- )`
;   kind 2 = compiler word (payload = an id dispatched by `br_table` in func 44)
;
; Memory map (window 2^20):
;   0x08000 messages + prelude (data)      0x10000 kernel globals (see the constant table)
;   0x10400 virtual stack   0x10C00 control stack   0x11400 block table   0x12400 type table
;   0x13000 output buffer   0x14000 open-block scratch   0x18000 closed-block arena
;   0x28000 assembled unit blob   0x38000 dictionary (32-byte entries)   0x4C000 REPL stack
;   0x50000 input buffer (256 KiB)   0x90000 heap (`here`)
;
; Kernel globals (8-byte cells at 0x10000 = 65536):
;   65536 HERE      65544 IN_POS    65552 IN_LEN    65560 DICT_N    65576 VS_DEPTH
;   65584 NEXTV     65592 NBLK      65600 CUR_BLK   65608 SCR_LEN   65616 CUR_INSTS
;   65624 CS_DEPTH  65632 MODE      65640 RDEPTH    65648 DEF_NIN   65656 DEF_NOUT
;   65664 OUT_LEN   65672 DEAD      65680 TOK_PTR   65688 TOK_LEN   65696 DEF_NAME_PTR
;   65704 DEF_NAME_LEN  65712 ERR   65720 CUR_PARAMS  65728 NTYPES  65736 BLOB_LEN
;   65744 ARENA_LEN 65752 IN_BASE   65760 NUM       65768 STR_PTR   65776 STR_LEN
;   65792.. 24-byte digit scratch
;
; Function index table (keep in sync — `call N` is by index):
;    0 _start            1 emit(c)           2 type(a,n)         3 allot(n)        4 comma(x)
;    5 flush()           6 sb(b)             7 suleb(v)          8 ssleb(v)        9 nv()
;   10 vs_push(v)       11 ensure(n)        12 vs_pop()         13 alloc_blk()    14 open_block(i,np)
;   15 close_block()    16 term_br(t)       17 term_br_if(c,t,e) 18 write_edge(t) 19 term_return(n)
;   20 term_unreachable 21 type_idx(ni,no)  22 emit_const(x)    23 emit_bin(op,a,b) 24 emit_load(op,a)
;   25 emit_store(op,a,v) 26 emit_calldyn(slot,ni,no) 27 emit_un(op,a) 28 emit_recurse(ni,no)
;   29 assemble(ni,no)  30 bb(b)            31 buleb(v)         32 btypes(n)      33 next_tok()
;   34 lookup(p,n)      35 add_entry(p,n,k,ni,no,pay)           36 parse_num(p,n) 37 streq(p1,p2,n)
;   38 error(msg,len)   39 print_i64(v)     40 anon_begin()     41 anon_flush()   42 process(p,n)
;   43 do_word(e)       44 do_imm(id)       45 do_colon()       46 do_semi()      47 do_prim()
;   48 read_stdin()     49 cs_push(k,a,b,c,d) 50 cs_pop()       51 parse_effect() 52 vs_params(n)
;   53 do_string()      54 strlen(p)        55 ab(b)            56 auleb(v)       57 skip_line()
;   58 skip_paren()     59 emit_flag(x)     60 is_newline()     61 do_control(id) 62 do_shuffle(id)
;   63 do_fiber(id)     64 do_defining(id)  65 next_num()      66 tramp(xt,x)    67 spawn(xt,x)
;   68 join(t)          69 wait(addr,exp)   70 notify(addr,n)  71 emit_execute(ni,no)

memory 20

import 0 "write" (i64, i64) -> (i64)
import 1 "read" (i64, i64) -> (i64)
import 2 "vm_jit_compile" (i64, i64) -> (i64)
import 3 "vm_jit_install" (i64) -> (i64)
import 4 "vm_jit_invoke2" (i64, i64, i64) -> (i64)
import 5 "vm_jit_release" (i64) -> (i64)
import 6 "vm_jit_uninstall" (i64) -> (i64)

export 0 func "_start" 0

; ---- messages (0x8000 = 32768) ----
data 32768 "stack underflow"
data 32784 "unknown word"
data 32800 "unterminated definition"
data 32832 "control structure mismatch"
data 32864 "stack effect mismatch"
data 32896 "compile error "
data 32912 "nested definition"
data 32944 "expected ( effect )"
data 32976 " near "
data 32992 "no such word"
data 33008 "prim"
data 33024 "--"
data 33040 "install error "
data 33056 "not compiling"
data 33072 "expected a name"

; ---- the prelude (0x9000 = 36864, NUL-terminated): the primitive table + the library, in Forth ----
data 36864 "prim : 2 0 0 1
prim ; 2 0 0 2
prim if 2 0 0 3
prim else 2 0 0 4
prim then 2 0 0 5
prim begin 2 0 0 6
prim until 2 0 0 7
prim again 2 0 0 8
prim while 2 0 0 9
prim repeat 2 0 0 10
prim dup 2 0 0 11
prim drop 2 0 0 12
prim swap 2 0 0 13
prim over 2 0 0 14
prim rot 2 0 0 15
prim nip 2 0 0 16
prim tuck 2 0 0 17
prim recurse 2 0 0 18
prim ' 2 0 0 19
prim .\" 2 0 0 20
prim s\" 2 0 0 21
prim variable 2 0 0 22
prim create 2 0 0 23
prim here 2 0 0 24
prim task 2 0 0 25
prim resume 2 0 0 26
prim yield 2 0 0 27
prim ( 2 0 0 28
prim \\ 2 0 0 29
prim execute0 2 0 0 30
prim execute1 2 0 0 31
prim execute2 2 0 0 32
prim exit 2 0 0 33
prim + 1 2 1 64
prim - 1 2 1 65
prim * 1 2 1 66
prim / 1 2 1 67
prim mod 1 2 1 69
prim and 1 2 1 71
prim or 1 2 1 72
prim xor 1 2 1 73
prim lshift 1 2 1 74
prim rshift 1 2 1 76
prim = 3 2 1 81
prim <> 3 2 1 82
prim < 3 2 1 83
prim u< 3 2 1 84
prim <= 3 2 1 85
prim > 3 2 1 87
prim >= 3 2 1 89
prim 0= 8 1 1 80
prim @ 4 1 1 241
prim c@ 4 1 1 249
prim ! 5 2 0 133
prim c! 5 2 0 138
prim emit 0 1 0 1
prim type 0 2 0 2
prim allot 0 1 0 3
prim , 0 1 0 4
prim spawn 0 2 1 67
prim join 0 1 1 68
prim wait 0 2 1 69
prim notify 0 2 1 70
prim atomic@ 10 1 1 0
prim atomic! 11 2 0 0
prim atomic+! 7 2 1 0
prim atomic-xchg 7 2 1 5
prim cas 9 3 1 0
: negate ( n -- n ) 0 swap - ;
: invert ( n -- n ) -1 xor ;
: 1+ ( n -- n ) 1 + ;
: 1- ( n -- n ) 1 - ;
: 2dup ( a b -- a b a b ) over over ;
: 2drop ( a b -- ) drop drop ;
: -rot ( a b c -- c a b ) rot rot ;
: cr ( -- ) 10 emit ;
: space ( -- ) 32 emit ;
: spaces ( n -- ) begin dup 0 > while space 1- repeat drop ;
: bl ( -- c ) 32 ;
: digit ( n -- ) 48 + emit ;
: u. ( u -- ) dup 10 < if digit else dup 10 / recurse 10 mod digit then ;
: . ( n -- ) dup 0 < if 45 emit negate then u. space ;
: abs ( n -- n ) dup 0 < if negate then ;
: min ( a b -- n ) 2dup > if swap then drop ;
: max ( a b -- n ) 2dup < if swap then drop ;
: cells ( n -- n ) 8 * ;
: +! ( n addr -- ) dup @ rot + swap ! ;
\0"

; ================================================================================================
; 0 _start: HERE = heap base; run the prelude, then all of stdin; flush.
func () -> (i32) {
block 0 () {
  hp = i64.const 65536
  heap = i64.const 589824
  i64.store hp heap
  pp = i64.const 36864
  pl = call 54 (pp)
  call 42 (pp, pl)
  n = call 48 ()
  ib = i64.const 327680
  call 42 (ib, n)
  call 5 ()
  z = i32.const 0
  return z
  }
}

; 1 emit(c): append to the output buffer; flush on newline or when full.
func (i64) -> () {
block 0 (c: i64) {
  lp = i64.const 65664
  len = i64.load lp
  ob = i64.const 77824
  a = i64.add ob len
  i64.store8 a c
  one = i64.const 1
  len1 = i64.add len one
  i64.store lp len1
  nl = i64.const 10
  isnl = i64.eq c nl
  cap = i64.const 4096
  full = i64.ge_s len1 cap
  x = i32.or isnl full
  br_if x 1() 2()
  }
block 1 () {
  call 5 ()
  return
  }
block 2 () {
  return
  }
}

; 2 type(a, n): emit n bytes from a.
func (i64, i64) -> () {
block 0 (a: i64, n: i64) {
  z = i64.const 0
  br 1(a, n, z)
  }
block 1 (a: i64, n: i64, i: i64) {
  c = i64.ge_s i n
  br_if c 3() 2(a, n, i)
  }
block 2 (a: i64, n: i64, i: i64) {
  p = i64.add a i
  ch = i64.load8_u p
  call 1 (ch)
  one = i64.const 1
  i1 = i64.add i one
  br 1(a, n, i1)
  }
block 3 () {
  return
  }
}

; 3 allot(n): HERE += n
func (i64) -> () {
block 0 (n: i64) {
  hp = i64.const 65536
  h = i64.load hp
  h1 = i64.add h n
  i64.store hp h1
  return
  }
}

; 4 comma(x): store a cell at HERE, HERE += 8
func (i64) -> () {
block 0 (x: i64) {
  hp = i64.const 65536
  h = i64.load hp
  i64.store h x
  eight = i64.const 8
  h1 = i64.add h eight
  i64.store hp h1
  return
  }
}

; 5 flush(): write the output buffer to stdout.
func () -> () {
block 0 () {
  lp = i64.const 65664
  len = i64.load lp
  z = i64.const 0
  e = i64.eq len z
  br_if e 2() 1(len)
  }
block 1 (len: i64) {
  ob = i64.const 77824
  r = call.import 0 (ob, len)
  lp = i64.const 65664
  z = i64.const 0
  i64.store lp z
  return
  }
block 2 () {
  return
  }
}

; 6 sb(b): append a byte to the open-block scratch (0x14000, len at SCR_LEN).
func (i64) -> () {
block 0 (b: i64) {
  lp = i64.const 65608
  len = i64.load lp
  base = i64.const 81920
  a = i64.add base len
  i64.store8 a b
  one = i64.const 1
  len1 = i64.add len one
  i64.store lp len1
  return
  }
}

; 7 suleb(v): unsigned LEB128 into scratch.
func (i64) -> () {
block 0 (v: i64) {
  br 1(v)
  }
block 1 (v: i64) {
  m = i64.const 127
  b7 = i64.and v m
  seven = i64.const 7
  rest = i64.shr_u v seven
  z = i64.const 0
  done = i64.eq rest z
  br_if done 3(b7) 2(b7, rest)
  }
block 2 (b7: i64, rest: i64) {
  hi = i64.const 128
  b = i64.or b7 hi
  call 6 (b)
  br 1(rest)
  }
block 3 (b7: i64) {
  call 6 (b7)
  return
  }
}

; 8 ssleb(v): signed LEB128 into scratch.
func (i64) -> () {
block 0 (v: i64) {
  br 1(v)
  }
block 1 (v: i64) {
  m = i64.const 127
  b7 = i64.and v m
  seven = i64.const 7
  rest = i64.shr_s v seven
  z = i64.const 0
  m1 = i64.const -1
  sb = i64.const 64
  sign = i64.and b7 sb
  signz = i64.eqz sign
  r0 = i64.eq rest z
  rm = i64.eq rest m1
  signnz = i64.ne sign z
  d1 = i32.and r0 signz
  d2 = i32.and rm signnz
  done = i32.or d1 d2
  br_if done 3(b7) 2(b7, rest)
  }
block 2 (b7: i64, rest: i64) {
  hi = i64.const 128
  b = i64.or b7 hi
  call 6 (b)
  br 1(rest)
  }
block 3 (b7: i64) {
  call 6 (b7)
  return
  }
}

; 9 nv(): allocate the next SSA value index in the open block.
func () -> (i64) {
block 0 () {
  p = i64.const 65584
  v = i64.load p
  one = i64.const 1
  v1 = i64.add v one
  i64.store p v1
  return v
  }
}

; 10 vs_push(v)
func (i64) -> () {
block 0 (v: i64) {
  dp = i64.const 65576
  d = i64.load dp
  eight = i64.const 8
  off = i64.mul d eight
  base = i64.const 66560
  a = i64.add base off
  i64.store a v
  one = i64.const 1
  d1 = i64.add d one
  i64.store dp d1
  return
  }
}

; 11 ensure(n): while the virtual stack holds fewer than n values, pull one from the persistent
; REPL stack (top-level anonymous unit only): emit a load and insert it at the bottom. In a
; named word (MODE 1) or with an empty REPL stack this is a stack-underflow error.
func (i64) -> () {
block 0 (n: i64) {
  ep = i64.const 65712
  err = i64.load ep
  z = i64.const 0
  bad = i64.ne err z
  br_if bad 8() 1(n)
  }
block 1 (n: i64) {
  dp = i64.const 65576
  d = i64.load dp
  ok = i64.ge_s d n
  br_if ok 8() 2(n, d)
  }
block 2 (n: i64, d: i64) {
  mp = i64.const 65632
  mode = i64.load mp
  rp = i64.const 65640
  rd = i64.load rp
  z = i64.const 0
  m1 = i64.ne mode z
  r0 = i64.eq rd z
  bad = i32.or m1 r0
  br_if bad 7() 3(n, d, rd)
  }
block 3 (n: i64, d: i64, rd: i64) {
  one = i64.const 1
  rd1 = i64.sub rd one
  rp = i64.const 65640
  i64.store rp rd1
  eight = i64.const 8
  off = i64.mul rd1 eight
  rs = i64.const 311296
  addr = i64.add rs off
  a = call 22 (addr)
  op = i64.const 241
  v = call 24 (op, a)
  br 4(n, d, v, d)
  }
block 4 (n: i64, d: i64, v: i64, i: i64) {
  z = i64.const 0
  at0 = i64.le_s i z
  br_if at0 6(n, d, v) 5(n, d, v, i)
  }
block 5 (n: i64, d: i64, v: i64, i: i64) {
  eight = i64.const 8
  base = i64.const 66560
  one = i64.const 1
  im1 = i64.sub i one
  offs = i64.mul im1 eight
  src = i64.add base offs
  x = i64.load src
  offd = i64.mul i eight
  dst = i64.add base offd
  i64.store dst x
  br 4(n, d, v, im1)
  }
block 6 (n: i64, d: i64, v: i64) {
  base = i64.const 66560
  i64.store base v
  one = i64.const 1
  d1 = i64.add d one
  dp = i64.const 65576
  i64.store dp d1
  br 1(n)
  }
block 7 () {
  m = i64.const 32768
  l = i64.const 15
  call 38 (m, l)
  return
  }
block 8 () {
  return
  }
}

; 12 vs_pop() -> v (0 after an error)
func () -> (i64) {
block 0 () {
  one = i64.const 1
  call 11 (one)
  ep = i64.const 65712
  err = i64.load ep
  z = i64.const 0
  bad = i64.ne err z
  br_if bad 2() 1()
  }
block 1 () {
  dp = i64.const 65576
  d = i64.load dp
  one = i64.const 1
  d1 = i64.sub d one
  i64.store dp d1
  eight = i64.const 8
  off = i64.mul d1 eight
  base = i64.const 66560
  a = i64.add base off
  v = i64.load a
  return v
  }
block 2 () {
  z = i64.const 0
  return z
  }
}

; 13 alloc_blk() -> NBLK++
func () -> (i64) {
block 0 () {
  p = i64.const 65592
  v = i64.load p
  one = i64.const 1
  v1 = i64.add v one
  i64.store p v1
  return v
  }
}

; 14 open_block(idx, nparams)
func (i64, i64) -> () {
block 0 (idx: i64, np: i64) {
  cb = i64.const 65600
  i64.store cb idx
  cp = i64.const 65720
  i64.store cp np
  z = i64.const 0
  sl = i64.const 65608
  i64.store sl z
  ci = i64.const 65616
  i64.store ci z
  nx = i64.const 65584
  i64.store nx np
  dd = i64.const 65672
  i64.store dd z
  return
  }
}

; 15 close_block(): write the open block (params, inst count, scratch bytes) to the arena and
; record its (offset, len) in the block table at BLKTAB[CUR_BLK].
func () -> () {
block 0 () {
  alp = i64.const 65744
  off = i64.load alp
  cpp = i64.const 65720
  np = i64.load cpp
  call 56 (np)
  z = i64.const 0
  br 1(off, np, z)
  }
block 1 (off: i64, np: i64, i: i64) {
  c = i64.ge_s i np
  br_if c 3(off) 2(off, np, i)
  }
block 2 (off: i64, np: i64, i: i64) {
  one = i64.const 1
  call 55 (one)
  i1 = i64.add i one
  br 1(off, np, i1)
  }
block 3 (off: i64) {
  cip = i64.const 65616
  ni = i64.load cip
  call 56 (ni)
  alp = i64.const 65744
  alen = i64.load alp
  arena = i64.const 98304
  dst = i64.add arena alen
  scr = i64.const 81920
  slp = i64.const 65608
  slen = i64.load slp
  mem.copy dst scr slen
  alen1 = i64.add alen slen
  i64.store alp alen1
  cbp = i64.const 65600
  cb = i64.load cbp
  sixteen = i64.const 16
  toff = i64.mul cb sixteen
  tab = i64.const 70656
  e = i64.add tab toff
  i64.store e off
  len = i64.sub alen1 off
  i64.store e len offset=8
  return
  }
}

; 16 term_br(t)
func (i64) -> () {
block 0 (t: i64) {
  op = i64.const 128
  call 6 (op)
  call 18 (t)
  call 15 ()
  return
  }
}

; 17 term_br_if(c, t, e)
func (i64, i64, i64) -> () {
block 0 (c: i64, t: i64, e: i64) {
  op = i64.const 129
  call 6 (op)
  call 7 (c)
  call 18 (t)
  call 18 (e)
  call 15 ()
  return
  }
}

; 18 write_edge(t): uleb target, then the whole virtual stack as branch args.
func (i64) -> () {
block 0 (t: i64) {
  call 7 (t)
  dp = i64.const 65576
  d = i64.load dp
  call 7 (d)
  z = i64.const 0
  br 1(d, z)
  }
block 1 (d: i64, i: i64) {
  c = i64.ge_s i d
  br_if c 3() 2(d, i)
  }
block 2 (d: i64, i: i64) {
  eight = i64.const 8
  off = i64.mul i eight
  base = i64.const 66560
  a = i64.add base off
  v = i64.load a
  call 7 (v)
  one = i64.const 1
  i1 = i64.add i one
  br 1(d, i1)
  }
block 3 () {
  return
  }
}

; 19 term_return(n): return the top n virtual-stack values.
func (i64) -> () {
block 0 (n: i64) {
  op = i64.const 131
  call 6 (op)
  call 7 (n)
  dp = i64.const 65576
  d = i64.load dp
  i0 = i64.sub d n
  br 1(d, i0)
  }
block 1 (d: i64, i: i64) {
  c = i64.ge_s i d
  br_if c 3() 2(d, i)
  }
block 2 (d: i64, i: i64) {
  eight = i64.const 8
  off = i64.mul i eight
  base = i64.const 66560
  a = i64.add base off
  v = i64.load a
  call 7 (v)
  one = i64.const 1
  i1 = i64.add i one
  br 1(d, i1)
  }
block 3 () {
  call 15 ()
  return
  }
}

; 20 term_unreachable()
func () -> () {
block 0 () {
  op = i64.const 143
  call 6 (op)
  call 15 ()
  return
  }
}

; 21 type_idx(nin, nout) -> index into the unit's type section (interned on demand).
func (i64, i64) -> (i64) {
block 0 (ni: i64, no: i64) {
  z = i64.const 0
  br 1(ni, no, z)
  }
block 1 (ni: i64, no: i64, i: i64) {
  np = i64.const 65728
  n = i64.load np
  c = i64.ge_s i n
  br_if c 4(ni, no, i) 2(ni, no, i)
  }
block 2 (ni: i64, no: i64, i: i64) {
  sixteen = i64.const 16
  off = i64.mul i sixteen
  tab = i64.const 74752
  e = i64.add tab off
  a = i64.load e
  b = i64.load e offset=8
  ea = i64.eq a ni
  eb = i64.eq b no
  both = i32.and ea eb
  br_if both 5(i) 3(ni, no, i)
  }
block 3 (ni: i64, no: i64, i: i64) {
  one = i64.const 1
  i1 = i64.add i one
  br 1(ni, no, i1)
  }
block 4 (ni: i64, no: i64, i: i64) {
  sixteen = i64.const 16

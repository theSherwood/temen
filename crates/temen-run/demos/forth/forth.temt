block 2 (ni: i64, no: i64, i: i64) {
  sixteen = i64.const 16
  off = i64.mul i sixteen
  tab = i64.const 74752
  e = i64.add tab off
  a = i64.load e
  b = i64.load e offset=8
  z = i64.const 0
  call 30 (z)
  call 32 (a)
  call 32 (b)
  one = i64.const 1
  i1 = i64.add i one
  br 1(ni, no, i1)
  }
block 3 (ni: i64, no: i64) {
  z = i64.const 0
  call 30 (z)
  one = i64.const 1
  call 30 (one)
  call 32 (ni)
  call 32 (no)
  nbp = i64.const 65592
  nb = i64.load nbp
  call 31 (nb)
  br 4(z)
  }
block 4 (i: i64) {
  nbp = i64.const 65592
  nb = i64.load nbp
  c = i64.ge_s i nb
  br_if c 6() 5(i)
  }
block 5 (i: i64) {

  call 30 (c84)
  c69 = i64.const 69
  call 30 (c69)
  c77 = i64.const 77
  call 30 (c77)
  call 30 (c69)
  c78 = i64.const 78
  call 30 (c78)
  call 30 (z)
  call 30 (z)
  call 30 (z)
  call 30 (z)
  call 30 (z)
  ten = i64.const 10
  call 30 (ten)
  call 30 (z)
  call 30 (z)
  call 30 (z)
  call 30 (z)
  call 30 (z)

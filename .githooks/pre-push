#!/usr/bin/env bash
# Pre-push hook — fast local mirror of CI's gating lint/compile jobs, plus the workspace tests.
#
# Purpose: catch the boring, common failures (formatting, lints, a broken build, a failing test on
# your host target) *before* they cost a CI round-trip. It is a convenience for fast feedback, NOT
# the authoritative gate — the CI matrix (Windows/macOS runtime, miri/asan/tsan/loom, fuzz,
# differential) still runs on the PR and is what actually protects `main`.
#
# The lint/compile half lives in `scripts/ci/local-gate.sh`, which this calls: one list of gates
# with two entry points (the hook, and a manual run), rather than two lists that drift. That script
# is also what pins the toolchain — it reads CI's `RUST_STABLE` out of the workflow, because a
# clippy clean on a *different* rustc than CI's is not a signal (a `for_kv_map` error once failed
# two CI jobs while the same command passed locally on an older toolchain). See AGENTS.md and
# `.github/workflows_src/README.md`.
#
# Enable (opt-in, per-clone):   git config core.hooksPath .githooks
#   or run:                     scripts/ci/install-git-hooks.sh
#
# Escape hatches:
#   TEMEN_HOOK_SKIP=1        git push   # skip the hook entirely (same as `git push --no-verify`)
#   TEMEN_HOOK_SKIP_TESTS=1  git push   # run the lint/compile gate, skip the (slower) test step
#   TEMEN_GATE_SKIP_CROSS=1  git push   # skip the windows-gnu cross-check inside the gate
#   TEMEN_GATE_INSTALL=1     git push   # let the gate install a missing toolchain/component/target
set -euo pipefail

if [ "${TEMEN_HOOK_SKIP:-0}" = "1" ]; then
  echo "pre-push: TEMEN_HOOK_SKIP=1 — skipping local checks."
  exit 0
fi

# Skip when every ref being pushed is a deletion (nothing to build/test).
only_deletes=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  case "$local_sha" in
    0000000000000000000000000000000000000000) : ;;  # branch deletion
    *) only_deletes=0 ;;
  esac
done
if [ "$only_deletes" = "1" ]; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Match CI's posture: warnings are hard errors (ci.yml sets RUSTFLAGS: "-D warnings").
export RUSTFLAGS="${RUSTFLAGS:--D warnings}"

run() {
  echo "pre-push: \$ $*"
  "$@"
}

echo "pre-push: running the fast CI subset (set TEMEN_HOOK_SKIP=1 to bypass)…"

# fmt · clippy (workspace + the stack-check lane) · excluded crates · windows-gnu cross-check,
# all on the toolchain CI pins.
run bash scripts/ci/local-gate.sh

# Build and test on that same toolchain, so a pass here means what it means on CI. `--workspace`
# does NOT cover the four crates the root manifest `exclude`s; the gate above ran
# `check-excluded.sh` for those.
toolchain="$(bash scripts/ci/local-gate.sh --print-toolchain)"
run rustup run "$toolchain" cargo build --workspace
if [ "${TEMEN_HOOK_SKIP_TESTS:-0}" = "1" ]; then
  echo "pre-push: TEMEN_HOOK_SKIP_TESTS=1 — skipping tests."
else
  run rustup run "$toolchain" cargo test --workspace
fi

echo "pre-push: OK — the CI matrix still runs the full gate on your PR."

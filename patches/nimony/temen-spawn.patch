diff --git a/lib/std/osproc.nim b/lib/std/osproc.nim
index 85206ca4..8918fc11 100644
--- a/lib/std/osproc.nim
+++ b/lib/std/osproc.nim
@@ -296,6 +296,39 @@ when not defined(windows):
           discard posix_spawnattr_destroy(attr)
       finally:
         discard posix_spawn_file_actions_destroy(actions)
+  elif defined(temen):
+    proc pspawnProcess(s: var LaunchState; workingDir: string;
+                       options: set[ProcessOption]): Pid {.raises.} =
+      # Temen spawns the child rather than forking it (`posix.pspawn`): the
+      # fork path's own steps, applied by the host to the child's copy of this
+      # fd table, and nothing else of this process copied. It has no
+      # `poDaemon` step: Temen serves a nim program no `setpgid`.
+      var acts = default(array[10, SpawnAction])
+      var n = 0
+      template act(o, f, a: int; p: nil cstring = nil) =
+        acts[n] = SpawnAction(op: o, fd: f, arg: a, path: p)
+        inc n
+      if poParentStreams notin options:
+        act SpawnDup2, s.pipes[0][readIdx], 0
+        act SpawnDup2, s.pipes[1][writeIdx], 1
+        if poStdErrToStdOut in options:
+          act SpawnDup2, s.pipes[1][writeIdx], 2
+        else:
+          act SpawnDup2, s.pipes[2][writeIdx], 2
+        for i in 0 ..< 3:
+          for j in 0 ..< 2:
+            act SpawnClose, s.pipes[i][j], 0
+      var wd = workingDir
+      if wd.len > 0:
+        act SpawnChdir, 0, 0, wd.toCString
+      result = Pid(-1)
+      for k in 0 ..< countCStringArray(s.paths):
+        var req = SpawnRequest(path: s.paths[k], argv: cast[CCharArray](s.args),
+          envp: cast[CCharArray](s.env),
+          actions: cast[ptr UncheckedArray[SpawnAction]](addr acts[0]), nactions: n)
+        result = pspawn(addr req)
+        if result >= Pid(0): return
+      raiseOSError(OSErrorCode(-result))  # -errno, nothing started
   else:
     proc forkProcess(s: var LaunchState; workingDir: string;
                      options: set[ProcessOption]): Pid {.raises.} =
@@ -361,6 +394,8 @@ when not defined(windows):
         echo command, " ", joinArgs(args, " ")
       when defined(illumos):
         let pid = spawnProcess(s, workingDir, options)
+      elif defined(temen):
+        let pid = pspawnProcess(s, workingDir, options)
       else:
         let pid = forkProcess(s, workingDir, options)
 
diff --git a/lib/std/posix/posix.nim b/lib/std/posix/posix.nim
index ce0cd67d..86327d0a 100644
--- a/lib/std/posix/posix.nim
+++ b/lib/std/posix/posix.nim
@@ -215,6 +215,31 @@ when defined(posix):
 
   when defined(illumos):
     include "illumos/spawn"
+  elif defined(temen):
+    # Temen's spawn, the POSIX personality's `pspawn`: a new process running
+    # `path`, with `actions` applied in order to its copy of the caller's fd
+    # table and nothing else of the caller copied. It answers the child's pid,
+    # or -errno with nothing created. `osproc` and `os` start every process
+    # with it on Temen, where a fork copies the caller's whole memory and
+    # keeps the caller off the tier that runs emitted code.
+    type
+      SpawnAction* = object
+        op*, fd*, arg*: int
+        path*: nil cstring  ## `SpawnChdir`'s directory
+      SpawnRequest* = object
+        path*: nil cstring
+        argv*, envp*: CCharArray
+        actions*: nil ptr UncheckedArray[SpawnAction]
+        nactions*: int
+    const
+      SpawnClose* = 1  ## close(fd)
+      SpawnDup2* = 2   ## dup2(fd, arg)
+      SpawnChdir* = 3  ## chdir(path)
+    proc pspawn*(req: ptr SpawnRequest): Pid {.importc: "pspawn", sideEffect.}
+    # A Temen link ignores this. A native build of a Temen program (what the
+    # self-hosted lane checks Temen's build against) links it: a `pspawn`
+    # that refuses.
+    {.compile: "temen_spawn.c".}
 
   proc execve*(path: cstring; argv, env: CCharArray): cint {.importc: "execve", sideEffect.}
   # waitpid is libc sugar for wait4 with NULL rusage. wait4 is exported by
diff --git a/lib/std/posix/temen_spawn.c b/lib/std/posix/temen_spawn.c
new file mode 100644
index 00000000..21df91bd
--- /dev/null
+++ b/lib/std/posix/temen_spawn.c
@@ -0,0 +1,9 @@
+/* `posix.pspawn` for a native build of a program built for Temen (`-d:temen`).
+   Temen serves `pspawn` to the program itself; natively nothing does, so a
+   spawn is refused and nothing is created. */
+#include <errno.h>
+
+int pspawn(void *req) {
+  (void)req;
+  return -ENOSYS;
+}

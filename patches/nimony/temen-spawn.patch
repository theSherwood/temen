diff --git a/lib/std/posix/posix.nim b/lib/std/posix/posix.nim
index df8d94a..6aa9ccb 100644
--- a/lib/std/posix/posix.nim
+++ b/lib/std/posix/posix.nim
@@ -568,6 +568,32 @@ when defined(posix):
   proc read*(fildes: cint; buf: pointer; nbyte: int): int {.importc: "read", sideEffect.}
   proc write*(fildes: cint; buf: pointer; nbyte: int): int {.importc: "write", sideEffect.}
 
+  when defined(temen):
+    # Temen's spawn, the POSIX personality's `pspawn`: a new process running
+    # `path`, with `actions` applied in order to its copy of the caller's fd
+    # table and nothing else of the caller copied. It answers the child's pid,
+    # or -errno with nothing created. `osproc` and `os` start every process
+    # with it on Temen, where a fork copies the caller's whole memory and
+    # keeps the caller off the tier that runs emitted code.
+    type
+      SpawnAction* = object
+        op*, fd*, arg*: int
+        path*: nil cstring  ## `SpawnChdir`'s directory
+      SpawnRequest* = object
+        path*: nil cstring
+        argv*, envp*: CCharArray
+        actions*: nil ptr UncheckedArray[SpawnAction]
+        nactions*: int
+    const
+      SpawnClose* = 1  ## close(fd)
+      SpawnDup2* = 2   ## dup2(fd, arg)
+      SpawnChdir* = 3  ## chdir(path)
+    proc pspawn*(req: ptr SpawnRequest): Pid {.importc: "pspawn", sideEffect.}
+    # A Temen link ignores this. A native build of a Temen program (what the
+    # self-hosted lane checks Temen's build against) links it: a `pspawn`
+    # that refuses.
+    {.compile: "temen_spawn.c".}
+
   # The environment block. The generated `main` captures its third parameter
   # (`char** envp`) into the `nimEnviron` global on every backend (see hexer's
   # genMainProc), so no libc `environ`/`_NSGetEnviron` binding is needed.
diff --git a/lib/std/posix/temen_spawn.c b/lib/std/posix/temen_spawn.c
new file mode 100644
index 0000000..21df91b
--- /dev/null
+++ b/lib/std/posix/temen_spawn.c
@@ -0,0 +1,9 @@
+/* `posix.pspawn` for a native build of a program built for Temen (`-d:temen`).
+   Temen serves `pspawn` to the program itself; natively nothing does, so a
+   spawn is refused and nothing is created. */
+#include <errno.h>
+
+int pspawn(void *req) {
+  (void)req;
+  return -ENOSYS;
+}
